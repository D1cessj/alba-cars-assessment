    {
      "parameters": {
        "jsCode": "const inventory = $('Read Inventory').all();\nconst recallResponses = $('Get NHTSA Recalls').all();\nconst seenItems = $input.all();\n\nconst seenCampaignNumbers = new Set(\n    seenItems.map(item => item.json.CampaignNumber).filter(v => v)\n  );\n\nconst newRecalls = [];\nconst errors = [];\n\nfor (let i = 0; i < inventory.length; i++) {\n    const vehicle = inventory[i].json;\n    const response = recallResponses[i] ? recallResponses[i].json : null;\n\n    if (!response || response.error) {\n          errors.push(vehicle.Make + ' ' + vehicle.Model + ' ' + vehicle.Year + ': ' + (response && response.error ? JSON.stringify(response.error).slice(0, 200) : 'no response'));\n          continue;\n    }\n\n    const results = response.results || [];\n    for (const recall of results) {\n          const campaignNumber = recall.NHTSACampaignNumber;\n          if (seenCampaignNumbers.has(campaignNumber)) continue;\n          seenCampaignNumbers.add(campaignNumber);\n\n          newRecalls.push({\n                  json: {\n                            isNewRecall: true,\n                            CampaignNumber: campaignNumber,\n                            Make: vehicle.Make,\n                            Model: vehicle.Model,\n                            Year: vehicle.Year,\n                            Component: recall.Component,\n                            Summary: recall.Summary,\n                            Manufacturer: recall.Manufacturer,\n                            ReportedDate: recall.ReportReceivedDate\n                  }\n          });\n    }\n}\n\nif (newRecalls.length === 0) {\n    return [{ json: { isNewRecall: false, vehiclesChecked: inventory.length, errorCount: errors.length, errors } }];\n}\n\nreturn newRecalls;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
