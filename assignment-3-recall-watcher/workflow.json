    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst rows = items.map(function(item) {\n    const r = item.json;\n    return '<tr>' +\n          '<td style=\"padding:6px;border:1px solid #ddd;\">' + r.Make + ' ' + r.Model + ' (' + r.Year + ')</td>' +\n          '<td style=\"padding:6px;border:1px solid #ddd;\">' + r.CampaignNumber + '</td>' +\n          '<td style=\"padding:6px;border:1px solid #ddd;\">' + r.Component + '</td>' +\n          '<td style=\"padding:6px;border:1px solid #ddd;\">' + String(r.Summary).slice(0, 200) + '...</td>' +\n          '</tr>';\n}).join('');\n\nconst html = '<h2>Alba Cars Recall Digest</h2>' +\n    '<p>' + items.length + ' new recall(s) found across your inventory.</p>' +\n    '<table style=\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;font-size:13px;\">' +\n    '<tr style=\"background:#f2f2f2;\">' +\n    '<th style=\"padding:6px;border:1px solid #ddd;text-align:left;\">Vehicle</th>' +\n    '<th style=\"padding:6px;border:1px solid #ddd;text-align:left;\">Campaign #</th>' +\n    '<th style=\"padding:6px;border:1px solid #ddd;text-align:left;\">Component</th>' +\n    '<th style=\"padding:6px;border:1px solid #ddd;text-align:left;\">Summary</th>' +\n    '</tr>' + rows + '</table>';\n\nreturn [{\n    json: {\n          htmlBody: html,\n          newCount: items.length,\n          timestamp: new Date().toISOString()\n    }\n}];"
      },
